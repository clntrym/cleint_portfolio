# Portfolio Client .htaccess
Options -Indexes

DirectoryIndex index.html

# Prevent direct access to sensitive file formats
<FilesMatch "\.(sql|log|env|git|md)$">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
